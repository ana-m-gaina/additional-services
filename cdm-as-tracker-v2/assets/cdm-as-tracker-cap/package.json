{
  "name": "cdm-as-tracker-cap",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "ui"
  ],
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "2.2.1",
    "jest": "^29"
  },
  "scripts": {
    "start": "cds-serve",
    "dev:cap": "cds watch",
    "dev:ui": "npm run dev --workspace=ui",
    "build": "npm run build --workspace=ui",
    "preview": "npm run build --workspace=ui && cds watch",
    "test": "jest --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "auth": {
        "kind": "dummy",
        "users": {
          "alex": {
            "password": "alex",
            "roles": [
              "CDM"
            ]
          },
          "ana": {
            "password": "ana",
            "roles": [
              "CDM",
              "Admin"
            ]
          },
          "morgan": {
            "password": "morgan",
            "roles": [
              "CDM",
              "Manager"
            ]
          },
          "pricingadmin": {
            "password": "pricingadmin",
            "roles": [
              "Admin"
            ]
          }
        }
      }
    },
    "[development]": {
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      }
    },
    "folders": {
      "app": "app"
    }
  }
}
