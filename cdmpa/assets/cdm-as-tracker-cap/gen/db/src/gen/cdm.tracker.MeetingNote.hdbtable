COLUMN TABLE cdm_tracker_MeetingNote (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  customerAgentId NVARCHAR(50) NOT NULL,
  clientName NVARCHAR(200),
  meetingDate DATE,
  rawText NCLOB,
  extractedJson NCLOB,
  topicsJson NCLOB,
  actionItemsJson NCLOB,
  risksJson NCLOB,
  decisionsJson NCLOB,
  processedBy NVARCHAR(200),
  PRIMARY KEY(ID)
)