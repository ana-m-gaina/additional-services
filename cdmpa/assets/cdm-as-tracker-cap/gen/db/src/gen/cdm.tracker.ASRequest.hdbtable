COLUMN TABLE cdm_tracker_ASRequest (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  ID NVARCHAR(50) NOT NULL,
  requestTitle NVARCHAR(200) NOT NULL,
  customerName NVARCHAR(200) NOT NULL,
  customerAccountId NVARCHAR(50),
  processType NVARCHAR(10) DEFAULT 'Classic',
  serviceCode NVARCHAR(20),
  serviceType NVARCHAR(100),
  additionalServiceIds NVARCHAR(500),
  rrDescription NVARCHAR(1000),
  description NVARCHAR(2000),
  sid NVARCHAR(20),
  caseNo NVARCHAR(100),
  csrNo NVARCHAR(100),
  sap4MeTicketId NVARCHAR(100),
  spcTicketId NVARCHAR(100),
  spcExecutionRef NVARCHAR(100),
  btpTicketId NVARCHAR(100),
  amsTicketId NVARCHAR(100),
  serviceNowTicketId NVARCHAR(100),
  bcpTicketNo NVARCHAR(50),
  itsmTicketNo NVARCHAR(100),
  price DECIMAL(15, 2),
  currency NVARCHAR(3) DEFAULT 'EUR',
  priceInWords NVARCHAR(500),
  priceValidUntil DATE,
  approvalText NVARCHAR(2000),
  poNumber NVARCHAR(100),
  poNo NVARCHAR(100),
  approvalDate SECONDDATE,
  approvalReceivedDate DATE,
  creationDate DATE,
  priceCommunicatedDate DATE,
  priceValidFrom DATE,
  customerClosureDate DATE,
  amsClosureDate DATE,
  deliveryDate SECONDDATE,
  invoiceDate SECONDDATE,
  jiraTicketRef NVARCHAR(100),
  jiraTicketBody NVARCHAR(5000),
  o2iTicketNo NVARCHAR(100),
  o2iTicketCreatedDate DATE,
  salesOrderNumber NVARCHAR(100),
  salesOrderNo NVARCHAR(100),
  providerContractNumber NVARCHAR(100),
  activityPerformed NVARCHAR(200),
  status NVARCHAR(50) DEFAULT 'New',
  assignedCDM NVARCHAR(100) NOT NULL,
  cdmOwner NVARCHAR(200),
  checkPriceEmailSent BOOLEAN DEFAULT FALSE,
  checkApprovalReceived BOOLEAN DEFAULT FALSE,
  checkSharePointUploaded BOOLEAN DEFAULT FALSE,
  checkCasSdInformed BOOLEAN DEFAULT FALSE,
  checkAmsClosed BOOLEAN DEFAULT FALSE,
  checkO2iCreated BOOLEAN DEFAULT FALSE,
  notes NCLOB,
  PRIMARY KEY(ID)
)